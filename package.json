{
  "name": "agent-sitemap",
  "version": "0.5.0",
  "description": "Turns your website into a linked Markdown map that AI agents can walk, opening only the pages they need.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "llms.txt",
    "markdown",
    "sitemap",
    "knowledge-graph",
    "okf"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Deckard-LLC/agent-sitemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deckard-LLC/agent-sitemap.git"
  },
  "bugs": "https://github.com/Deckard-LLC/agent-sitemap/issues",
  "type": "module",
  "bin": {
    "agent-sitemap": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@inquirer/prompts": "8.7.5",
    "turndown": "7.2.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/turndown": "5.0.6",
    "typescript": "5.9.3"
  }
}
